Algoritmo pacientes_hospital

Definir n, i, numero, index, opcionMenu Como Entero
Definir posicion_paciente Como Entero
Definir nombre_paciente, cedula_paciente, consulta_paciente, gravedad_paciente Como Cadena
Definir nombre, cedula, consulta, gravedad, buscador, auxNombre, auxCedula, auxConsulta, auxGravedad Como Cadena
Definir error, cedulaUnica, encontrada, encontrado, hayPacientes Como Logico

Dimension posicion_paciente[14]
Dimension nombre_paciente[14]
Dimension cedula_paciente[14]
Dimension consulta_paciente[14]
Dimension gravedad_paciente[14]

n <- 4 + 10

Para i <- 0 Hasta n - 1 Con Paso 1 Hacer
	cedula_paciente[i] <- ""
FinPara

Para numero <- 0 Hasta n - 1 Con Paso 1 Hacer
	error <- Falso
	
	Escribir "Menú:"
	Escribir "1. Agregar paciente"
	Escribir "2. Buscar pacientes"
	Escribir "3. Modificar paciente"
	Escribir "4. Eliminar paciente"
	Escribir "5. Mostrar lista de pacientes"
	
	Repetir
		Escribir "Que opción desea realizar?: "
		Leer opcionMenu
		error <- Falso
		
		Segun opcionMenu Hacer
			1:
				Escribir ""
				Escribir "---Agreguemos un paciente---"
				Escribir ""
				
				index <- -1
				Para i <- 0 Hasta n - 1 Con Paso 1 Hacer
					Si cedula_paciente[i] = "" Y index = -1 Entonces
						index <- i
					FinSi
				FinPara
				
				Si index = -1 Entonces
					Escribir "No hay espacio para más pacientes."
				Sino
					Repetir
						Escribir "Ingrese el nombre del paciente: "
						Leer nombre
						Si nombre = "" Entonces
							Escribir "El nombre no puede estar vacío."
						FinSi
					Hasta Que nombre <> ""
					
					cedulaUnica <- Falso
					Repetir
						Escribir "Ingrese la cédula del paciente: "
						Leer cedula
						Si cedula = "" Entonces
							Escribir "La cédula no puede estar vacía."
						Sino
							encontrada <- Falso
							Para i <- 0 Hasta n - 1 Con Paso 1 Hacer
								Si cedula_paciente[i] = cedula Entonces
									encontrada <- Verdadero
								FinSi
							FinPara
							
							Si encontrada Entonces
								Escribir "La cédula ya está registrada. Ingrese una cédula distinta."
							Sino
								cedulaUnica <- Verdadero
							FinSi
						FinSi
					Hasta Que cedulaUnica = Verdadero
					
					Repetir
						Escribir "Ingrese la consulta del paciente: "
						Leer consulta
						Si consulta = "" Entonces
							Escribir "La consulta no puede estar vacía."
						FinSi
					Hasta Que consulta <> ""
					
					Repetir
						Escribir "Ingrese la gravedad del paciente: "
						Leer gravedad
						Si gravedad = "" Entonces
							Escribir "La gravedad no puede estar vacía."
						FinSi
					Hasta Que gravedad <> ""
					
					posicion_paciente[index] <- index + 1
					nombre_paciente[index] <- nombre
					cedula_paciente[index] <- cedula
					consulta_paciente[index] <- consulta
					gravedad_paciente[index] <- gravedad
					Escribir "Paciente agregado exitosamente."
				FinSi
				
			2:
				Escribir ""
				Escribir "---Busquemos un paciente---"
				Escribir ""
				Escribir "Ingresa el número de cédula del paciente que deseas encontrar: "
				Leer buscador
				encontrado <- Falso
				
				Para i <- 0 Hasta n - 1 Con Paso 1 Hacer
					Si buscador = cedula_paciente[i] Entonces
						Escribir ""
						Escribir "Posición: ", posicion_paciente[i]
						Escribir "Nombre: ", nombre_paciente[i]
						Escribir "Cédula: ", cedula_paciente[i]
						Escribir "Consulta: ", consulta_paciente[i]
						Escribir "Gravedad: ", gravedad_paciente[i]
						encontrado <- Verdadero
					FinSi
				FinPara
				
				Si No encontrado Entonces
					Escribir "Paciente no encontrado."
				FinSi
				
			3:
				Escribir ""
				Escribir "---Modificar paciente---"
				Escribir ""
				Escribir "Ingrese la cédula del paciente que desea modificar: "
				Leer buscador
				encontrado <- Falso
				
				Para i <- 0 Hasta n - 1 Con Paso 1 Hacer
					Si buscador = cedula_paciente[i] Entonces
						Escribir "Ingrese el nuevo nombre del paciente: "
						Leer auxNombre
						nombre_paciente[i] <- auxNombre
						
						Escribir "Ingrese la nueva cédula del paciente: "
						Leer auxCedula
						cedula_paciente[i] <- auxCedula
						
						Escribir "Ingrese la nueva consulta del paciente: "
						Leer auxConsulta
						consulta_paciente[i] <- auxConsulta
						
						Escribir "Ingrese la nueva gravedad del paciente: "
						Leer auxGravedad
						gravedad_paciente[i] <- auxGravedad
						
						Escribir "Paciente modificado exitosamente."
						encontrado <- Verdadero
					FinSi
				FinPara
				
				Si No encontrado Entonces
					Escribir "Paciente no encontrado."
				FinSi
				
			4:
				Escribir ""
				Escribir "---Eliminar paciente---"
				Escribir ""
				Escribir "Ingrese la cédula del paciente que desea eliminar: "
				Leer buscador
				encontrado <- Falso
				
				Para i <- 0 Hasta n - 1 Con Paso 1 Hacer
					Si buscador = cedula_paciente[i] Entonces
						nombre_paciente[i] <- ""
						cedula_paciente[i] <- ""
						consulta_paciente[i] <- ""
						gravedad_paciente[i] <- ""
						Escribir "Paciente eliminado exitosamente."
						encontrado <- Verdadero
					FinSi
				FinPara
				
				Si No encontrado Entonces
					Escribir "Paciente no encontrado."
				FinSi
				
			5:
				Escribir ""
				Escribir "---Lista de pacientes registrados---"
				Escribir ""
				hayPacientes <- Falso
				
				Para i <- 0 Hasta n - 1 Con Paso 1 Hacer
					Si cedula_paciente[i] <> "" Entonces
						Escribir "Posición: ", posicion_paciente[i]
						Escribir "Nombre: ", nombre_paciente[i]
						Escribir "Cédula: ", cedula_paciente[i]
						Escribir "Consulta: ", consulta_paciente[i]
						Escribir "Gravedad: ", gravedad_paciente[i]
						Escribir "------------------------"
						hayPacientes <- Verdadero
					FinSi
				FinPara
				
				Si No hayPacientes Entonces
					Escribir "No hay pacientes registrados en este momento."
				FinSi
				
			De Otro Modo:
				Escribir "Opción inválida"
				Escribir "Intenta nuevamente..."
				Escribir ""
				error <- Verdadero
		FinSegun
	Hasta Que error = Falso
FinPara
Escribir "-------Fin del programa-------"
FinAlgoritmo
